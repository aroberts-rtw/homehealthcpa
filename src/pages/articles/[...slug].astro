---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { siteConfig } from '../../data/site';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const canonicalUrl = new URL(`/articles/${entry.id}`, siteConfig.url).toString();
---
<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  author={entry.data.author}
  licenseNumber={entry.data.licenseNumber}
  targetQuery={entry.data.targetQuery}
  ctaHeadline={entry.data.ctaHeadline}
  ctaBody={entry.data.ctaBody}
  canonicalUrl={canonicalUrl}
  faqs={entry.data.faqs}
>
  <Content />
</ArticleLayout>
