---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../data/site';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const sorted = allArticles.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const title = 'Articles — HomeHealthCPA';
const description = 'Accounting, tax, and financial management articles for home health agency owners and administrators. Written by Askia Roberts, CPA.';
---
<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-4xl px-6 py-16">
    <h1 class="font-serif text-3xl font-bold text-slate-900 mb-4">Articles</h1>
    <p class="text-slate-600 mb-12 max-w-xl">Accounting, tax, and financial management for home health agency owners. Written by Askia Roberts, CPA (GA License #{siteConfig.founder.licenseNumber}).</p>

    {sorted.length === 0 && (
      <p class="text-slate-500">Articles are being prepared. Check back shortly.</p>
    )}

    <div class="space-y-8">
      {sorted.map((article) => (
        <article class="border-b border-stone-200 pb-8 last:border-0">
          <a href={`/articles/${article.id}`} class="group">
            <h2 class="font-serif text-xl font-bold text-slate-900 group-hover:text-teal-700 transition">{article.data.title}</h2>
            <p class="mt-2 text-slate-600 leading-relaxed">{article.data.description}</p>
            <p class="mt-3 text-xs text-slate-400">{article.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })} · By {article.data.author}</p>
          </a>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
